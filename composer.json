{
  "name": "arillo/silverstripe-elements",
  "description": "Elements",
  "type": "silverstripe-vendormodule",
  "homepage": "https://github.com/arillo/silverstripe-elements",
  "keywords": [
    "silverstripe",
    "elements"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Daniel Murcia",
      "email": "dm@arillo.net"
    },
    {
      "name": "Sebastian Fischer",
      "email": "sf@arillo.net"
    }
  ],
  "require": {
    "silverstripe/framework": "^5",
    "symbiote/silverstripe-gridfieldextensions": "^4.1",
    "colymba/gridfield-bulk-editing-tools": "^4.1"
  },
  "extra": {
    "installer-name": "elements",
    "expose": [
      "client"
    ]
  },
  "autoload": {
    "psr-4": {
      "Arillo\\Elements\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Arillo\\Elements\\Tests\\": "tests/"
    }
  },
  "support": {
    "issues": "https://github.com/arillo/silverstripe-elements/issues"
  }
}